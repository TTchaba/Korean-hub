# ── Public configuration ─────────────────────────────────────────────
# Full public URL of the deployed site (used for SEO metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Private server configuration (never expose to the browser) ───────
# Firebase service account (Firebase console → Project settings →
# Service accounts → Generate new private key). Firestore is only ever
# accessed from the server, so no public Firebase config is needed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences from the JSON key file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
